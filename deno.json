{
  "name": "@evanlouie/vimium-webkit",
  "version": "0.1.0",
  "exports": "./src/main.ts",
  "license": "MIT",
  "tasks": {
    "build": "deno run -A build/build.ts",
    "build:dev": "deno run -A build/build.ts --dev",
    "watch": "deno run -A build/build.ts --watch",
    "check": "deno check src/ build/ test/",
    "test": "deno test -A test/",
    "coverage": "rm -rf .coverage && deno test -A --coverage=.coverage test/ && deno coverage .coverage --include='^file://.*/src/' --detailed",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "verify": "deno task fmt:check && deno task lint && deno task check && deno task check:e2e && deno task test && deno task build && deno task test:e2e",
    "check:e2e": "deno check playwright.config.ts test/e2e/",
    "serve:fixtures": "deno run -A test/e2e/harness/server.ts",
    "test:e2e": "deno run -A --node-modules-dir=auto npm:@playwright/test test",
    "test:e2e:ui": "deno run -A --node-modules-dir=auto npm:@playwright/test test --ui",
    "test:e2e:install": "deno run -A --node-modules-dir=auto npm:@playwright/test install webkit chromium firefox"
  },
  "imports": {
    "zod/mini": "npm:zod@^4.1.12/mini",
    "neverthrow": "npm:neverthrow@^8.2.0",
    "esbuild": "npm:esbuild@^0.25.10",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@^0.11.1",
    "@std/assert": "jsr:@std/assert@^1.0.14",
    "@std/path": "jsr:@std/path@^1.1.2",
    "@std/fs": "jsr:@std/fs@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.16",
    "@playwright/test": "npm:@playwright/test@^1.56.0",
    "~/": "./src/"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "useUnknownInCatchVariables": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "esnext"
    ]
  },
  "lint": {
    "include": ["src/", "build/", "test/", "playwright.config.ts"],
    "rules": {
      "tags": ["recommended"],
      "include": [
        "no-explicit-any",
        "explicit-module-boundary-types",
        "no-await-in-loop",
        "eqeqeq"
      ],
      "exclude": ["no-window"]
    }
  },
  "fmt": {
    "include": [
      "src/",
      "build/",
      "test/",
      "playwright.config.ts",
      "*.md",
      "*.json"
    ],
    "lineWidth": 80,
    "proseWrap": "always"
  },
  "exclude": ["dist/", "node_modules/", "test-results/"]
}
